{
  "name": "thediscombill",
  "version": "1.0.0",
  "description": "Free browser-based electricity bill calculator for all Indian DISCOMs.",
  "type": "module",
  "private": true,
  "scripts": {
    "seo": "node generate-seo.js",
    "build": "node build.js",
    "test": "node tests/engine.test.mjs && node tests/bill-ocr.test.mjs && node tests/site.test.mjs",
    "tariff:db": "node scripts/build-tariff-database.mjs",
    "orders:archive": "node scripts/archive-orders.mjs",
    "tariff:fresh": "node scripts/tariff-freshness.mjs",
    "tariff:fresh:check": "node scripts/tariff-freshness.mjs --check",
    "api:bundle": "node scripts/sync-calc-api.mjs",
    "serve": "npx http-server . -p 3456",
    "og": "node scripts/og-images.mjs",
    "icons": "node scripts/icons.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "indexnow:all": "node scripts/indexnow.mjs --all"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/navinbhaskar/TheDiscomBill"
  }
}
