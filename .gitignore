# Dependencies
node_modules/

# Generated tariff dataset — build artifact, deliberately NOT published.
# The site is served from the repo root and the repo is public, so a committed copy would be
# live at two public URLs at once. It lives in a dot-directory so that Jekyll would skip it
# even if this rule were ever removed. CI regenerates it with `npm run seo` before the tests
# that read it, so nothing depends on it being committed.
.build/

# Build output
dist/

# Local Claude Code settings (machine-specific)
.claude/settings.local.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/

# Cloudflare Wrangler local state
.wrangler/

# Local Claude Code tooling artifacts (not website content)
.claude/skills/
.claude/launch.json
skills-lock.json
graphify-out/
js/graphify-out/

# Deploy-time copies for the calc Edge Function (scripts/sync-calc-api.mjs)
supabase/functions/calc/vendor/
supabase/functions/calc/bundle.ts

# SEO audit artifacts (32MB of screenshots + crawl data) — local analysis, never deployed
*-audit/
# The audit write-up itself. Local working notes, not website content: the repo root is served
# publicly, so a committed copy would be live at thediscombill.com/FULL-AUDIT-REPORT.md.
FULL-AUDIT-REPORT.md
